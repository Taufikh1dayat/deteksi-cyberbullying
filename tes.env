import os
import requests
import json

# ── 🔑 KONFIGURASI API KEY & DAFTAR MODEL GRATIS ─────────────────────────────
# Ambil dari environment variable atau file .streamlit/secrets.toml
OPENROUTER_API_KEY = os.getenv("OPENROUTER_API_KEY", "")
if not OPENROUTER_API_KEY:
    try:
        import tomllib
        with open(".streamlit/secrets.toml", "rb") as f:
            secrets = tomllib.load(f)
            OPENROUTER_API_KEY = secrets.get("OPENROUTER_API_KEY", "")
    except Exception:
        pass

# Daftar model gratis terpopuler di OpenRouter untuk kamu uji coba
DAFTAR_MODEL = [
    "tencent/hy3:free",                      # Tencent Hunyuan 3 (Gratis & Stabil)
    "poolside/Laguna-XS-2.1:free"          # Laguna XS 2.1B (Gratis & Cepat)
]

# ── 📝 PROMPT PENGUJIAN (SIMULASI LAYER XAI) ─────────────────────────────────
# Ini adalah contoh prompt yang mirip dengan yang ada di skripsi Bab III kamu
TEKS_TWEET = "Kaum cebong kapir udah keliatan dongoknya dari awal tambah dongok lagi hahahah"
LABEL_PREDIKSI = "Cyberbullying"
BOBOT_LIME = "'kapir' (+0.1250), 'dongoknya' (+0.0980), 'cebong' (+0.0820)"

PROMPT_UJI = f"""
Teks Cuitan Konten: "{TEKS_TWEET}"
Hasil Prediksi Akhir: [{LABEL_PREDIKSI}]
Nilai Key-Features LIME: {BOBOT_LIME}
Bertindaklah sebagai pakar Linguistik Forensik Siber. Jelaskan dalam 2 atau 3 kalimat santun bahasa Indonesia, 
keterkaitan makna kata kunci di atas sehingga memutuskan sebagai {LABEL_PREDIKSI}.
"""

# ── 🚀 ENGINE PENGUJI AUTOMATIS ──────────────────────────────────────────────
def uji_model_openrouter(nama_model, prompt):
    url = "https://openrouter.ai/api/v1/chat/completions"
    headers = {
        "Authorization": f"Bearer {OPENROUTER_API_KEY}",
        "Content-Type": "application/json",
        "HTTP-Referer": "http://localhost:8501",
        "X-Title": "Testing Script Fik"
    }
    payload = {
        "model": nama_model,
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0.7
    }
    
    print(f"\n⏳ Menghubungi Cloud API untuk model: [{nama_model}]...")
    try:
        response = requests.post(url, headers=headers, json=payload, timeout=20)
        if response.status_code == 200:
            hasil = response.json()
            jawaban = hasil['choices'][0]['message']['content'].strip()
            print(f"✅ RESPONS MODEL [{nama_model}]:")
            print(f"   \"{jawaban}\"")
        else:
            print(f"❌ Gagal (Status Code: {response.status_code})")
            print(f"   Detail Error: {response.text}")
    except Exception as e:
        print(f"💥 Terjadi kesalahan koneksi: {e}")

# Loop untuk menguji semua model di dalam daftar secara otomatis
if __name__ == "__main__":
    if OPENROUTER_API_KEY == "GANTI_DENGAN_API_KEY_KAMU":
        print("⚠️ Masukkan API Key OpenRouter kamu terlebih dahulu di dalam kode!")
    else:
        print("🏁 MEMULAI PENGUJIAN MODEL AI GRATIS OPENROUTER...")
        for model in DAFTAR_MODEL:
            uji_model_openrouter(model, PROMPT_UJI)
            print("-" * 80)